# Copy to .env.local and fill in to enable Claude-narrated briefings.
# Without this key, ChainSight falls back to its rule-based engine wording.
ANTHROPIC_API_KEY=

# Optional: override the model used for the dashboard briefing.
# Defaults to claude-opus-5. claude-sonnet-5 is a cheaper option.
# CHAINSIGHT_BRIEFING_MODEL=claude-opus-5
