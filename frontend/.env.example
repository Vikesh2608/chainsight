# Copy to .env.local and fill in to enable Claude-narrated briefings.
# Without this key, ChainSight falls back to its rule-based engine wording.
ANTHROPIC_API_KEY=

# Optional: override the model used for the dashboard briefing.
# Defaults to claude-opus-5. claude-sonnet-5 is a cheaper option.
# CHAINSIGHT_BRIEFING_MODEL=claude-opus-5

# Optional: email delivery for the "Email" button in every Report bar.
# With RESEND_API_KEY set, /api/report/email sends the report with the
# CSV attached. Without it, the button falls back to the user's own mail
# client (summary pre-filled, no attachment).
RESEND_API_KEY=
# From address for sent reports. Defaults to onboarding@resend.dev
# (works only for the account that owns the Resend key). Use a verified
# domain address in production.
# REPORT_FROM_EMAIL=ChainSight <reports@yourdomain.com>
